# Copy to .env and override as needed. All variables are optional; sensible
# defaults for the shared ParaBank demo live in src/utils/config.ts.

# qa | staging | local
TEST_ENV=qa

# Overrides the resolved environment's UI base URL. Must end in "/" — page
# objects use paths with no leading slash, which resolve relative to it.
# BASE_URL=https://parabank.parasoft.com/parabank/

# Overrides the resolved environment's REST API base URL.
# API_BASE_URL=https://parabank.parasoft.com/parabank/services/bank

# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
